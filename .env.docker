# Copy to .env.docker and fill in values:
#   cp .env.docker.example .env.docker
# Then: docker compose --env-file .env.docker up --build

# ---------- PostgreSQL ----------
DB_NAME=HospitalManagement
DB_USER=postgres
DB_PASSWORD=Ermivan@24
# Host port mapping (optional)
DB_HOST_PORT=5433

# ---------- JWT (REQUIRED — min 32 characters) ----------
# Generate: openssl rand -base64 48
JWT_SECRET=fgklfkghlkjglkjlkj4l35jlk456lk6jl5k6jlk7jl6k7jljhjkjkjhkjh4789879535jjhkj3hghfgjgkdfjghkjh
JWT_ISSUER=HospitalSys
JWT_AUDIENCE=HospitalSysClient
JWT_EXPIRATION_MINUTES=120
JWT_COOKIE_NAME=jwt
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=

# ---------- CORS (frontend origin) ----------
CORS_ORIGINS=http://localhost:8080,http://bishoftu.edu.et,http://bishoftu.edu.et:8080,http://10.232.78.74:8080
