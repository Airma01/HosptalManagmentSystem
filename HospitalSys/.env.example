# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is gitignored.
# For Docker / production, inject the same variables via docker-compose or your orchestrator.
# Rotate any secrets that were previously committed to source control.

# Database (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=HospitalManagement
DB_USER=postgres
DB_PASSWORD=7475

# Alternatively, set the full connection string:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=HospitalManagement;Username=postgres;Password=CHANGE_THIS

# JWT — generate a new long random secret (e.g. openssl rand -base64 48)
# The previous hardcoded secret is compromised and must NOT be reused.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=HospitalSys
JWT_AUDIENCE=HospitalSysClient
JWT_EXPIRATION_MINUTES=120
JWT_COOKIE_NAME=jwt
# false for local HTTP; true for production HTTPS
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Leave empty for host-only cookies (recommended)
JWT_COOKIE_DOMAIN=

# CORS (comma-separated origins; must match frontend origin when using credentials)
CORS_ORIGINS=http://localhost:5173

# Gemini AI (server-side only — never expose to the React frontend)
GEMINI_API_KEY=

# Application
ASPNETCORE_ENVIRONMENT=Development
