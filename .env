# Copy to .env and fill real values. NEVER commit .env
# Generate JWT secret: openssl rand -base64 48

# PostgreSQL
POSTGRES_DB=HospitalManagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=7475

# JWT (minimum 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=HospitalSys
JWT_AUDIENCE=HospitalSysClient
JWT_EXPIRATION_MINUTES=120
JWT_COOKIE_NAME=jwt
# false for local HTTP (hospital.local); true for production HTTPS
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Leave empty for host-only cookies (recommended)
JWT_COOKIE_DOMAIN=

# CORS — same origin when using Nginx at hospital.local
CORS_ORIGINS=http://hospital.local,http://localhost

ASPNETCORE_ENVIRONMENT=Production

# Optional
GEMINI_API_KEY=
